# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used to send invite emails; never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (notification batches and due-date reminders). Any SMTP sender works; free options:
# Gmail with an app password (smtp.gmail.com:465) or Brevo (smtp-relay.brevo.com:587).
# Locally, Mailpit catches everything at 127.0.0.1:54325 (view it at http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bird-Watcher <field-book@example.com>
# Shared secret the database scheduler sends to /api/cron/email. Locally it matches supabase/seed.sql;
# in production use a long random string and store the same value in Vault (see docs/PLAN.md).
CRON_SECRET=local-dev-cron-secret
